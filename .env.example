# MechCAD new-architecture model configuration.
# Vision model: reads sketch evidence.
MECHCAD_VISION_PROVIDER=dashscope
MECHCAD_VISION_API_KEY=
MECHCAD_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MECHCAD_VISION_MODEL=qwen3-vl-plus
MECHCAD_VISION_PROTOCOL=openai
MECHCAD_VISION_TIMEOUT=120
MECHCAD_VISION_MAX_RETRIES=2

# Planner model: turns evidence into FeaturePlanV3.
MECHCAD_PLANNER_PROVIDER=custom
MECHCAD_PLANNER_API_KEY=
MECHCAD_PLANNER_BASE_URL=https://api.lingshuai.cc
MECHCAD_PLANNER_MODEL=gpt-5.5
MECHCAD_PLANNER_PROTOCOL=openai
MECHCAD_PLANNER_TIMEOUT=180
MECHCAD_PLANNER_MAX_RETRIES=2

# Optional provider profiles managed by the model console. One set is stored per
# role and provider, letting the UI switch back without re-entering API keys.
# MECHCAD_MODEL_PROFILE__VISION__DEEPSEEK__API_KEY=
# MECHCAD_MODEL_PROFILE__VISION__DEEPSEEK__BASE_URL=https://api.deepseek.com
# MECHCAD_MODEL_PROFILE__VISION__DEEPSEEK__MODEL=deepseek-chat
# MECHCAD_MODEL_PROFILE__VISION__DEEPSEEK__PROTOCOL=openai

# Build123d CAD worker timeout. Increase for slow first-time imports/export.
MECHCAD_CAD_TIMEOUT=90
MECHCAD_CAD_ENGINE=build123d

# MechKernel agent worker（P1）。kernel 仓库路径与解释器；缺省取 aicad 旁的 mechcad-kernel。
# MECHCAD_KERNEL_REPO=G:/lfy design/ai cad/mechcad-kernel
# MECHCAD_KERNEL_PYTHON=G:/lfy design/ai cad/mechcad-kernel/.venv/Scripts/python.exe
# MECHCAD_KERNEL_TIMEOUT=120

# Startup update check. Check-only: Varen CAD never downloads or installs updates.
# MECHCAD_UPDATE_CHECK=true
# MECHCAD_RELEASE_REPO=vanyu0710/Varen-AI-CAD
# MECHCAD_UPDATE_CHANNEL=beta
# MECHCAD_UPDATE_TIMEOUT=4
# MECHCAD_UPDATE_CACHE_SECONDS=21600

# Legacy names are intentionally omitted from the new architecture example.

