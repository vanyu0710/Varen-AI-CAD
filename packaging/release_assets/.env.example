# Varen CAD 打包版配置 —— 复制为 .env 放在 VarenCAD.exe 同目录后填写。
# 不配置也能启动：UI 与本地建模/几何功能可用；AI agent 建模需要 planner key。

# ── planner（AI agent 的大脑，必需）────────────────────────────
# 任意 OpenAI 兼容 / Anthropic 兼容网关均可
MECHCAD_PLANNER_BASE_URL=https://api.openai.com/v1
MECHCAD_PLANNER_API_KEY=sk-xxxxxx
MECHCAD_PLANNER_MODEL=gpt-4o
MECHCAD_PLANNER_PROTOCOL=openai

# ── vision（可选：截图理解/证据复核，纯文字流程可不配）──────────
#MECHCAD_VISION_BASE_URL=
#MECHCAD_VISION_API_KEY=
#MECHCAD_VISION_MODEL=
#MECHCAD_VISION_PROTOCOL=openai

# ── 服务端口（默认 8001；被占用时改这里）───────────────────────
#MECHCAD_PORT=8001
#MECHCAD_HOST=127.0.0.1
